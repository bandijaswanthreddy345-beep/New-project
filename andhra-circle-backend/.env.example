# ==============================================================================
# JNTU Circle (Andhra Circle) - Backend Environment Configuration Template
# DO NOT PUT REAL SECRETS IN THIS FILE. Copy this file to .env and fill in values.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/andhra-circle?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/andhra-circle

# JSON Web Token Signing Secret (Must be high-entropy, at least 32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_random_96_character_secret_key_here_min_32_chars

# Allowed CORS Origins (comma-separated for production)
# Example: https://jntucircle.com,https://www.jntucircle.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# EmailJS Service Credentials (Used for password reset emails)
EMAILJS_SERVICE_ID=service_placeholder
EMAILJS_TEMPLATE_ID=template_placeholder
EMAILJS_PUBLIC_KEY=public_key_placeholder
EMAILJS_PRIVATE_KEY=private_key_placeholder

# Chatbot AI (Google Gemini free tier). Get a key in Google AI Studio.
# Keep it ONLY here - never in the frontend or in chat messages.
# Recommended models: gemini-3.1-flash-lite, gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CHAT_DAILY_CAP=800

# Frontend Application Base URL (Used to construct password reset links)
FRONTEND_URL=http://localhost:5173

